<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.sistema_bancario_po.controller.CadastroController"
           styleClass="fundo" prefWidth="480" prefHeight="600" stylesheets="@style.css">
    <VBox alignment="CENTER" maxWidth="360" maxHeight="480" spacing="12" styleClass="card">
        <Label text="Criar conta" styleClass="titulo"/>
        <Label text="Preencha seus dados" styleClass="subtitulo"/>
        <TextField fx:id="tfNome" promptText="Nome completo" styleClass="campo"/>
        <TextField fx:id="tfCpf" promptText="CPF (somente números)" styleClass="campo"/>
        <PasswordField fx:id="pfSenha" promptText="Senha (mín. 4 caracteres)" styleClass="campo"/>
        <PasswordField fx:id="pfConfirmar" promptText="Confirmar senha" styleClass="campo"/>
        <Button text="Cadastrar" styleClass="botao" maxWidth="Infinity" onAction="#cadastrar"/>
        <Button text="Já tenho conta" styleClass="botao-link" onAction="#voltar"/>
    </VBox>
</StackPane>